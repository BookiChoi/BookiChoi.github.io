---
import '@fontsource-variable/jetbrains-mono';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/tokens.css';
import { SITE_NAME, getT, type Lang } from '../i18n';

interface Props { title?: string; fullTitle?: string; lang: Lang; path: string; description?: string }
const { title, lang, path, description } = Astro.props;
const t = getT(lang);
const url = (l: string) => new URL(`/${l}${path}`, Astro.site).href;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} | ${SITE_NAME}` : SITE_NAME);
// 확인 안 된 문구(TODO)는 검색·링크 미리보기에 내보내지 않는다
const desc = description && !description.trimStart().startsWith('TODO') ? description : undefined;
const ogImage = new URL('/og-image.png', Astro.site).href;
const locale = (l: Lang) => (l === 'ko' ? 'ko_KR' : 'en_US');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="ko" href={url('ko')} />
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#050507" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale(lang)} />
    <meta property="og:locale:alternate" content={locale(lang === 'ko' ? 'en' : 'ko')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {desc && <meta name="twitter:description" content={desc} />}
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
