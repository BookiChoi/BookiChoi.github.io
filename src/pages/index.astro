---
import '../styles/tokens.css';
import { SITE_NAME, getT } from '../i18n';
const t = getT('en');
const en = new URL('/en/', Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={en} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="ko" href={new URL('/ko/', Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#050507" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={en} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        var l = localStorage.getItem('language');
        if (l !== 'en' && l !== 'ko') l = (navigator.language || '').toLowerCase().startsWith('ko') ? 'ko' : 'en';
        location.replace('/' + l + '/');
      } catch (e) { location.replace('/en/'); }
    </script>
  </head>
  <body>
    <main>
      <h1>{SITE_NAME}</h1>
      <noscript><p><a href="/en/">English</a> · <a href="/ko/">한국어</a></p></noscript>
    </main>
  </body>
</html>
