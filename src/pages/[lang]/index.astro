---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import '../../styles/stage.css';
import { LANGS, SITE_NAME, SITE_SHORT, getT, type Lang } from '../../i18n';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'en' ? 'ko' : 'en';
const t = getT(lang);
const items = (await getCollection('projects'))
  .filter((p) => p.id.endsWith(`/${lang}`))
  .sort((a, b) => a.data.order - b.data.order);

// 히어로 이름: 단어 → 글자, 글자마다 스태거 순번
let n = 0;
const words = SITE_NAME.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---
<Base lang={lang} path="/" description={t.intro}>
  <Stage />
  <header class="site-header">
    <a class="label" href={`/${lang}/`} aria-label={SITE_NAME}>{SITE_SHORT}</a>
    <a class="label" href={`/${other}/`} hreflang={other} lang={other}>{t.switchLang}</a>
  </header>
  <main id="main" class="stage-main">
    <section id="s0" class="s0">
      <h1 class="hero-name" aria-label={SITE_NAME}>
        {words.map((w, wi) => (
          <>{wi > 0 && ' '}<span class="word">{w.map((l) => <span aria-hidden="true" style={`--i:${l.i}`}>{l.ch}</span>)}</span></>
        ))}
      </h1>
      <p class="scroll-hint label" aria-hidden="true">{t.scroll}<span class="scroll-line"></span></p>
    </section>
    <section id="s1" class="tall">
      <div class="pin">
        <h2>{t.role}</h2>
        <p>{t.intro}</p>
      </div>
    </section>
    <section id="s2" class="tall">
      <div class="pin">
        <h2 class="label">{t.s2Label}</h2>
        <ul>{t.s2.map((line) => <li>{line}</li>)}</ul>
      </div>
    </section>
    <section id="s3" class="tall">
      <div class="pin">
        <h2 class="label">{t.s3Label}</h2>
        <ul>{t.s3.map((line) => <li>{line}</li>)}</ul>
      </div>
    </section>
    <section id="s4">
      <div id="projects">
        <h2>{t.projects}</h2>
        <ul class="project-list">
          {items.map((p) => (
            <li>
              <a href={`/${lang}/projects/${p.id.split('/')[0]}/`}>{p.data.title}</a>
              <p>{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>
