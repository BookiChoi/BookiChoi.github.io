---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import NameInk from '../../components/NameInk.astro';
import Stage from '../../components/Stage.astro';
import About from '../../components/About.astro';
// display 타입 프리셋 a/b/c 폰트(홈 전용). 브라우저는 실제로 쓰는 프리셋의 파일만 내려받는다.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/outfit/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../../styles/stage.css';
import { LANGS, SITE_NAME, SITE_SHORT, getT, type Lang } from '../../i18n';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'en' ? 'ko' : 'en';
const t = getT(lang);
const items = (await getCollection('projects'))
  .filter((p) => p.id.endsWith(`/${lang}`))
  .sort((a, b) => a.data.order - b.data.order);

// 히어로 이름: 단어 → 글자, 글자마다 스태거 순번. 마지막 단어는 강조(em, 프리셋 c에서 italic).
let n = 0;
const words = SITE_NAME.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
// 큰 문구: [앞부분(끝 공백 포함), 마지막 단어]. 마지막 단어는 em(프리셋 c에서 italic)
const lastWord = (s: string) => {
  const i = s.lastIndexOf(' ');
  return [s.slice(0, i + 1), s.slice(i + 1)];
};
const [s1a, s1b] = lastWord(t.role);
const [s2a, s2b] = lastWord(t.s2);
const [s3a, s3b] = lastWord(t.s3);
const [s4a, s4b] = lastWord(t.s4);
const sections = [
  { id: 's0', label: SITE_NAME },
  { id: 's1', label: t.s1Label },
  { id: 's2', label: t.s2Label },
  { id: 's3', label: t.s3Label },
  { id: 's4', label: t.s4Label },
  { id: 's5', label: t.projects },
  { id: 's6', label: t.about },
];
// 3D 책(books.ts)이 읽는 데이터. HTML 안 JSON이라 '<'는 이스케이프한다
const books = JSON.stringify(
  items.map((p) => ({
    slug: p.id.split('/')[0],
    title: p.data.title,
    summary: p.data.summary,
    hue: p.data.coverHue,
    order: p.data.order,
    href: `/${lang}/projects/${p.id.split('/')[0]}/`,
  })),
).replace(/</g, '\\u003c');
---
<Base lang={lang} path="/" description={t.intro}>
  <Stage />
  <header class="site-header">
    <a class="label" href={`/${lang}/`} aria-label={SITE_NAME}>{SITE_SHORT}</a>
    <a class="label" href={`/${other}/`} hreflang={other} lang={other}>{t.switchLang}</a>
  </header>
  <SectionNav label={t.sections} items={sections} />
  <main id="main" class="stage-main" data-snap>
    <section id="s0" class="snap screen s0">
      <h1 class="hero-name display" aria-label={SITE_NAME}>
        {words.map((w, wi) => {
          const Word = wi === words.length - 1 ? 'em' : 'span';
          return (
            <>{wi > 0 && ' '}<Word class="word">{w.map((l) => <span aria-hidden="true" style={`--i:${l.i}`}>{l.ch}</span>)}</Word></>
          );
        })}
      </h1>
      <NameInk />
      <p class="scroll-hint label" aria-hidden="true">{t.scroll}<span class="scroll-line"></span></p>
    </section>
    <section id="s1" class="snap screen">
      <div class="wrap">
        <p class="label eyebrow reveal" style="--i:0">{t.s1Label}</p>
        <h2 class="role display reveal" style="--i:1">{s1a}<em>{s1b}</em></h2>
      </div>
    </section>
    <section id="s2" class="snap screen">
      <div class="wrap">
        <p class="label eyebrow reveal" style="--i:0">{t.s2Label}</p>
        <h2 class="role display reveal" style="--i:1">{s2a}<em>{s2b}</em></h2>
      </div>
    </section>
    <section id="s3" class="snap screen">
      <div class="wrap">
        <p class="label eyebrow reveal" style="--i:0">{t.s3Label}</p>
        <h2 class="role display reveal" style="--i:1">{s3a}<em>{s3b}</em></h2>
      </div>
    </section>
    <section id="s4" class="snap screen">
      <div class="wrap">
        <p class="label eyebrow reveal" style="--i:0">{t.s4Label}</p>
        <h2 class="role display reveal" style="--i:1">{s4a}<em>{s4b}</em></h2>
        <p class="note reveal" style="--i:2">{t.s4Note}</p>
      </div>
    </section>
    <section id="s5" class="snap">
      <div id="projects">
        <h2 class="label eyebrow reveal" style="--i:0">{t.s5}</h2>
        <ul class="project-list">
          {items.map((p, i) => (
            <li class="reveal" style={`--i:${i + 1}`}>
              <a href={`/${lang}/projects/${p.id.split('/')[0]}/`}>{p.data.title}</a>
              <p>{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
      <script type="application/json" id="books-data" set:html={books} />
      <div class="book-nav">
        <button type="button" class="book-prev" aria-label={t.prev}>←</button>
        <button type="button" class="book-next" aria-label={t.next}>→</button>
      </div>
      <div id="book-tip" class="book-tip" aria-hidden="true" hidden>
        <strong></strong>
        <p></p>
        <span class="label">{t.open} →</span>
      </div>
    </section>
    <About t={t} />
  </main>
</Base>
