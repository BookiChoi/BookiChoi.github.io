---
// S6(ABOUT): 소개 글 + 스킬. 스킬의 원본은 그룹별 <ul>(스크린리더, JS 꺼짐에서 그대로 보임).
// JS가 있으면: S6 전용 3D 원근 별밭(canvas 2D)과 로고 배지 사본(aria-hidden)이 떠다니고, "스킬 보기"를 누르면
// 소개 글이 점 입자로 쪼개져 워프로 지나가고(실패·reduced-motion이면 블록 페이드) 사본이 스킬 화면
// (헤더 아래 고정 오버레이, 페이지 높이 불변)의 각 li 자리로 모인다. 닫으면 역순.
// 로고는 빌드 때 simple-icons에서 SVG path와 브랜드 색을 꺼내 인라인한다(클라이언트 번들에는 없음).
import * as si from 'simple-icons';
import type { SimpleIcon } from 'simple-icons';
import { SKILL_GROUPS, type Skill } from '../data/skills';
import type { getT } from '../i18n';
import '../styles/about.css';
interface Props { t: ReturnType<typeof getT> }
const { t } = Astro.props;

const icons = si as unknown as Record<string, SimpleIcon>;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// 브랜드 색 → 배지 로고 칸 배경: 채도 ≤ 0.65, 밝기 0.30~0.55. 거의 검정인 브랜드는 중립 칸
const rgb = (hex: string) => [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
const toHsl = ([r, g, b]: number[]) => {
  const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2, d = max - min;
  if (!d) return [0, 0, l];
  const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
  const h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
  return [h * 60, s, l];
};
const fromHsl = (h: number, s: number, l: number) => {
  const k = (n: number) => (n + h / 30) % 12;
  const a = s * Math.min(l, 1 - l);
  return [0, 8, 4].map((n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1)));
};
const lum = (c: number[]) => c.map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)).reduce((a, v, i) => a + v * [0.2126, 0.7152, 0.0722][i], 0);
const logo = (s: Skill) => {
  if (!s.icon) return `<span class="badge-logo mark">${esc(s.mark ?? s.name.slice(0, 2))}</span>`;
  const ic = icons[`si${s.icon[0].toUpperCase()}${s.icon.slice(1)}`];
  if (!ic) throw new Error(`simple-icons에 '${s.icon}' 없음`);
  const [h, sat, l] = toHsl(rgb(ic.hex));
  let bg = '#2b2e3a', fg = '#fff';
  if (l >= 0.15) {
    const c = fromHsl(h, Math.min(sat, 0.65), Math.min(0.55, Math.max(0.3, l)));
    bg = `rgb(${c.map((v) => Math.round(v * 255)).join(' ')})`;
    fg = lum(c) > 0.3 ? '#111' : '#fff';
  }
  return `<span class="badge-logo" style="background:${bg};color:${fg}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="${ic.path}"/></svg></span>`;
};
const badge = (s: Skill) => `<span class="badge">${logo(s)}<span class="badge-name">${esc(s.name)}</span></span>`;

let n = 0;
const groups = SKILL_GROUPS.map((g, gi) => ({ id: g.id, items: g.items.map((s) => ({ i: n++, g: gi, html: badge(s) })) }));
// 떠다니는 순서: 그룹을 돌아가며 하나씩(모바일에서 앞 24개만 보여도 네 그룹이 다 들어간다)
const floats: { i: number; g: number; html: string }[] = [];
for (let k = 0; floats.length < n; k++) for (const g of groups) if (g.items[k]) floats.push(g.items[k]);
---
<section id="s6" class="snap">
  <div class="s6-space" aria-hidden="true">
    <canvas class="s6-stars"></canvas>
    <div class="s6-badges">
      {floats.map((f) => <span class="fl" data-i={f.i} data-g={f.g} set:html={f.html} />)}
    </div>
  </div>
  <div class="s6-story">
    <div class="about">
      <div class="about-head">
        <h2 class="label about-label reveal s6-out" style="--i:0;--k:0">{t.about}</h2>
        <p class="about-lead display reveal s6-out" style="--i:1;--k:1"><em>{t.aboutLead}</em></p>
      </div>
      <div class="about-body">
        {t.aboutBody.map((para, i) => <p class="reveal s6-out" style={`--i:${i + 2};--k:${i + 2}`}>{para}</p>)}
        <button type="button" class="skills-btn skills-open reveal s6-out" style="--i:8;--k:8" aria-expanded="false" aria-controls="s6-skills" hidden>{t.skillsShow}</button>
      </div>
    </div>
  </div>
  <div id="s6-skills" class="s6-skills" role="region" aria-label={t.skillsLabel}>
    <div class="s6-skills-inner">
      <button type="button" class="skills-btn skills-close" hidden>{t.skillsBack}</button>
      {groups.map((g) => (
        <section class="skill-lane">
          <h3 class="label">{t.skillGroups[g.id]}</h3>
          <ul>{g.items.map((s) => <li data-i={s.i} set:html={s.html} />)}</ul>
        </section>
      ))}
      <p class="skills-tm">{t.skillsTrademark}</p>
    </div>
  </div>
</section>

<script>
  const sec = document.getElementById('s6');
  const story = sec?.querySelector<HTMLElement>('.s6-story');
  const panel = document.getElementById('s6-skills');
  const openBtn = sec?.querySelector<HTMLButtonElement>('.skills-open');
  const closeBtn = sec?.querySelector<HTMLButtonElement>('.skills-close');
  const canvas = sec?.querySelector<HTMLCanvasElement>('.s6-stars');
  const layer = sec?.querySelector<HTMLElement>('.s6-badges');
  const ctx = canvas?.getContext('2d');
  if (sec && story && panel && openBtn && closeBtn && canvas && layer && ctx) {
    const root = document.documentElement;
    root.classList.add('skills-on');
    openBtn.hidden = closeBtn.hidden = false;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = () => matchMedia('(max-width: 899px)').matches;
    const nav = document.querySelector<HTMLElement>('.section-nav');
    const MOVE = 900; // 배지 이동
    const STAGGER = 60; // 그룹 순서 시차
    const FADE = 250; // 사본 ↔ li 교차 페이드
    const rnd = (a: number, b: number) => a + Math.random() * (b - a);

    // --- 3D 원근 별밭(canvas 2D): 별마다 화면 방향 (u, v)와 깊이 z. 화면 위치 = 중심 + (u, v)·F / z ---
    // 천천히 카메라 쪽으로 다가오고(가까울수록 크고 밝고 빠름), 지나가거나 화면을 벗어나면 먼 곳에서 다시 생긴다.
    // 절반 남짓은 군집(가우시안)에서, 나머지는 균등하게 생겨 빽빽한 곳과 빈 곳이 섞인다.
    const COLORS = ['#e6ecff', '#cfd8ff', '#b8c6ff', '#9fb2ff', '#c6b8ff', '#b0a4f5'];
    const ZMIN = 0.06;
    const SPEED = 0.035; // 깊이 단위/초(평소)
    let W = 0, H = 0, F = 1, CX = 0, CY = 0, off = 0, t = 0;
    let boost = 1; // 워프 때 별 속도 배율
    type Star = { u: number; v: number; z: number; r0: number; a: number; c: string; glow: boolean; age: number; w: number; p: number };
    let stars: Star[] = [];
    let clusters: { x: number; y: number; s: number }[] = [];
    const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) * 2; // 근사 정규분포(표준편차 1)
    const spawn = (s: Star, z: number) => {
      let x: number, y: number;
      if (Math.random() < 0.55) {
        const k = clusters[Math.floor(Math.random() * clusters.length)];
        x = k.x + gauss() * k.s;
        y = k.y + gauss() * k.s;
      } else {
        x = rnd(0, W);
        y = rnd(0, H);
      }
      s.u = ((x - CX) * z) / F;
      s.v = ((y - CY) * z + off) / F;
      s.z = z;
      s.age = reduce ? 9 : 0; // 새 별은 투명에서 서서히 밝아진다
    };
    const glowImg = document.createElement('canvas');
    glowImg.width = glowImg.height = 32;
    const gctx = glowImg.getContext('2d');
    if (gctx) {
      const g = gctx.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, 'rgba(210, 218, 255, 1)');
      g.addColorStop(1, 'rgba(210, 218, 255, 0)');
      gctx.fillStyle = g;
      gctx.fillRect(0, 0, 32, 32);
    }
    const sizeStars = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      F = Math.max(W, H) * 0.5;
      CX = W / 2;
      CY = Math.min(H, innerHeight) / 2;
      off = 0;
      clusters = Array.from({ length: 6 + Math.floor(Math.random() * 4) }, () => ({ x: rnd(0, W), y: rnd(0, H), s: rnd(0.04, 0.12) * Math.min(W, H) }));
      stars = Array.from({ length: narrow() ? 200 : 450 }, () => {
        const s: Star = { u: 0, v: 0, z: 1, r0: rnd(0.22, 0.36), a: rnd(0.45, 0.75), c: COLORS[Math.floor(Math.random() * COLORS.length)], glow: Math.random() < 0.3, age: 0, w: rnd(0.3, 0.9), p: rnd(0, 6.3) };
        spawn(s, rnd(ZMIN * 2, 1));
        s.age = 9; // 처음 별들은 바로 보인다
        return s;
      });
    };
    const drawStars = (dt: number) => {
      off = Math.max(0, -sec.getBoundingClientRect().top) * 0.03; // S6 안 스크롤: 시선을 조금 올린다(가까운 별이 더 움직임)
      ctx.clearRect(0, 0, W, H);
      ctx.lineCap = 'round';
      const streak = boost > 2;
      for (const s of stars) {
        s.z -= SPEED * boost * dt;
        s.age += dt;
        const x = CX + (s.u * F) / s.z, y = CY + (s.v * F - off) / s.z;
        if (s.z < ZMIN || x < -20 || x > W + 20 || y < -20 || y > H + 20) {
          spawn(s, rnd(0.85, 1));
          continue;
        }
        const r = Math.max(0.45, Math.min(1.8, s.r0 / s.z));
        const al = s.a * (0.5 + 0.5 * (1 - s.z)) * Math.min(1, s.age / 1.5) * (reduce ? 1 : 0.85 + 0.15 * Math.sin(s.w * t + s.p));
        ctx.globalAlpha = al;
        if (streak) {
          // 모션 트레일: 조금 더 먼 깊이의 투영 위치에서 지금 위치까지
          const zb = s.z + SPEED * boost * 0.08;
          ctx.strokeStyle = s.c;
          ctx.lineWidth = 2 * r;
          ctx.beginPath();
          ctx.moveTo(CX + (s.u * F) / zb, CY + (s.v * F - off) / zb);
          ctx.lineTo(x, y);
          ctx.stroke();
        } else {
          ctx.fillStyle = s.c;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
        if (s.glow && s.z < 0.35) {
          const g = r * 8;
          ctx.globalAlpha = al * 0.3;
          ctx.drawImage(glowImg, x - g / 2, y - g / 2, g, g);
        }
      }
      ctx.globalAlpha = 1;
    };

    // --- 글 → 점: 화면에 보이는 소개 글을 오프스크린 canvas에 같은 위치·폰트로 다시 그려 픽셀을 샘플링한다 ---
    // 열 때와 닫을 때마다 새로 잰다(그 순간의 레이아웃과 폰트라 폰트 늦은 로드·resize에 따로 대응할 필요가 없다).
    type Warp = { t0: number; dir: 1 | -1; n: number; b: Float32Array; ci: Uint8Array; cols: string[]; size: number; cx: number; cy: number };
    let warp: Warp | null = null;
    const WARP_SHAKE = 250, WARP_FLY = 700, WARP_FADE = 200;
    const sampleText = (): Omit<Warp, 't0' | 'dir'> | null => {
      const cr = canvas.getBoundingClientRect();
      const vw = Math.ceil(cr.width), vh = Math.ceil(Math.min(cr.height, innerHeight - cr.top));
      if (vw < 1 || vh < 1) return null;
      const oc = document.createElement('canvas');
      oc.width = vw;
      oc.height = vh;
      const c = oc.getContext('2d', { willReadFrequently: true });
      if (!c) return null;
      c.globalCompositeOperation = 'lighter'; // 글 색마다 채널을 나눠 그린다(R, G, B = 색 0, 1, 2)
      const CH = ['#f00', '#0f0', '#00f'];
      const cols: string[] = [];
      const range = document.createRange();
      for (const el of story.querySelectorAll<HTMLElement>('.s6-out')) {
        const er = el.getBoundingClientRect();
        if (er.bottom < cr.top || er.top > cr.top + vh) continue;
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
          const tn = node;
          const cs = getComputedStyle(tn.parentElement!);
          let ci = cols.indexOf(cs.color);
          if (ci < 0) ci = cols.length < 3 ? cols.push(cs.color) - 1 : 0;
          c.fillStyle = c.strokeStyle = CH[ci];
          c.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
          const perChar = !!parseFloat(cs.letterSpacing); // 자간이 있으면 글자 단위로 위치를 잰다('normal' → NaN)
          const upper = cs.textTransform === 'uppercase';
          const chars = (s: number, e: number) => {
            for (let i = s; i < e; ) {
              const l = tn.data.codePointAt(i)! > 0xffff ? 2 : 1;
              put(i, i + l, true);
              i += l;
            }
          };
          const put = (s: number, e: number, single = false) => {
            range.setStart(tn, s);
            range.setEnd(tn, e);
            const rs = range.getClientRects();
            if (rs.length !== 1 && !single) return chars(s, e); // 줄이 나뉜 단어
            const r = rs[0];
            if (!r || !r.width) return;
            const str = upper ? tn.data.slice(s, e).toUpperCase() : tn.data.slice(s, e);
            const asc = c.measureText(str).fontBoundingBoxAscent ?? r.height * 0.8;
            c.fillText(str, r.left - cr.left, r.top - cr.top + asc);
          };
          for (const m of tn.data.matchAll(/\S+/g)) {
            if (perChar) chars(m.index!, m.index! + m[0].length);
            else put(m.index!, m.index! + m[0].length);
          }
        }
        if (el instanceof HTMLButtonElement) {
          c.lineWidth = 1;
          c.beginPath();
          c.roundRect(er.left - cr.left + 0.5, er.top - cr.top + 0.5, er.width - 1, er.height - 1, er.height / 2);
          c.stroke();
        }
      }
      const d = c.getImageData(0, 0, vw, vh).data;
      const filled: number[] = [];
      for (let i = 0, p = 0; i < d.length; i += 4, p++) if (d[i] > 128 || d[i + 1] > 128 || d[i + 2] > 128) filled.push(p);
      if (!filled.length) return null;
      // 격자 칸마다 글 픽셀 하나: 칸 수가 상한 근처가 되도록 간격을 키운 뒤, 남는 것은 무작위로 덜어 상한을 지킨다
      const MAX = narrow() ? 1500 : 3500;
      let g = Math.max(1, Math.floor(Math.sqrt(filled.length / MAX)));
      let picked: number[] = [];
      for (;; g++) {
        const cw = Math.ceil(vw / g);
        const seen = new Uint8Array(cw * Math.ceil(vh / g));
        picked = [];
        for (const p of filled) {
          const cell = Math.floor((p % vw) / g) + Math.floor(Math.floor(p / vw) / g) * cw;
          if (!seen[cell]) {
            seen[cell] = 1;
            picked.push(p);
          }
        }
        if (picked.length <= MAX * 1.2) break;
      }
      for (let i = 0; i < Math.min(MAX, picked.length); i++) {
        const j = i + Math.floor(Math.random() * (picked.length - i));
        [picked[i], picked[j]] = [picked[j], picked[i]];
      }
      picked.length = Math.min(MAX, picked.length);
      const chan = (p: number) => (d[p * 4] > 128 ? 0 : d[p * 4 + 1] > 128 ? 1 : 2);
      picked.sort((a, b) => chan(a) - chan(b)); // 색이 바뀔 때만 fillStyle을 바꾸게
      const n = picked.length;
      const b = new Float32Array(n * 7); // x0, y0, 흩어짐 방향 dx, dy, 속도 계수 k, 이전 x, 이전 y
      const ci = new Uint8Array(n);
      picked.forEach((p, i) => {
        const a = Math.random() * Math.PI * 2;
        b.set([(p % vw) + 0.5, Math.floor(p / vw) + 0.5, Math.cos(a) * rnd(0.3, 1), Math.sin(a) * rnd(0.3, 1), rnd(0.75, 1.3), NaN, NaN], i * 7);
        ci[i] = chan(p);
      });
      return { n, b, ci, cols, size: Math.min(2.4, Math.max(1.1, g * 0.55)), cx: CX, cy: CY };
    };
    // 열기: 떨림·흩어짐(WARP_SHAKE) → 소실점에서 바깥으로 가속하며 커지고 흐려져 지나간다(WARP_FLY).
    // 닫기: 같은 공식을 거꾸로(바깥에서 감속하며 수렴) → 떨림이 가라앉고 → DOM 글과 교차 페이드(WARP_FADE).
    const drawWarp = (now: number) => {
      if (!warp) return;
      const w = warp, tau = now - w.t0;
      let u: number, sc: number, al: number;
      if (w.dir > 0) {
        sc = 1 - (1 - Math.min(1, tau / WARP_SHAKE)) ** 2;
        u = Math.max(0, (tau - WARP_SHAKE) / WARP_FLY);
        if (u >= 1) {
          warp = null;
          return;
        }
        al = (1 - u) ** 1.4;
      } else {
        u = Math.max(0, 1 - tau / WARP_FLY);
        sc = (1 - Math.min(1, Math.max(0, tau - WARP_FLY) / WARP_SHAKE)) ** 2;
        al = (1 - u) ** 1.4 * Math.max(0, 1 - Math.max(0, tau - WARP_FLY - WARP_SHAKE) / WARP_FADE);
        if (al <= 0) return;
      }
      const e = u * u, b = w.b, shake = u === 0 ? sc * 1.2 : 0;
      ctx.globalAlpha = al;
      ctx.lineCap = 'round';
      let col = -1;
      for (let i = 0, o = 0; i < w.n; i++, o += 7) {
        if (w.ci[i] !== col) {
          col = w.ci[i];
          ctx.fillStyle = ctx.strokeStyle = w.cols[col];
        }
        const bx = b[o] + b[o + 2] * 6 * sc + (shake ? (Math.random() - 0.5) * shake : 0);
        const by = b[o + 1] + b[o + 3] * 6 * sc + (shake ? (Math.random() - 0.5) * shake : 0);
        const z = 1 - 0.94 * Math.min(1, e * b[o + 4]);
        const x = w.cx + (bx - w.cx) / z, y = w.cy + (by - w.cy) / z;
        const s = Math.min(8, w.size / z);
        const px = b[o + 5], py = b[o + 6];
        if (u > 0 && px === px && Math.abs(x - px) + Math.abs(y - py) > s) {
          ctx.lineWidth = s * 0.7;
          ctx.beginPath();
          ctx.moveTo(px, py);
          ctx.lineTo(x, y);
          ctx.stroke();
        } else ctx.fillRect(x - s / 2, y - s / 2, s, s);
        b[o + 5] = x;
        b[o + 6] = y;
      }
      ctx.globalAlpha = 1;
    };

    // --- 떠다니는 배지 사본: 배지마다 독립된 느린 곡선 경로(방향이 천천히 휜다), 깊이에 따라 크기·속도·투명도 ---
    type Fl = { el: HTMLElement; li: HTMLElement; g: number; w: number; h: number; x: number; y: number; z: number; th: number; o1: number; p1: number; o2: number; p2: number; r: number; s: number; op: number };
    const items = new Map([...panel.querySelectorAll<HTMLElement>('li')].map((li) => [li.dataset.i, li]));
    let fls: Fl[] = [];
    const floatTransform = (f: Fl) => `translate3d(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px, 0) rotate(${f.r.toFixed(2)}deg) scale(${f.s.toFixed(3)})`;
    const initBadges = () => {
      const BW = layer.clientWidth, BH = layer.clientHeight;
      fls = [...layer.querySelectorAll<HTMLElement>('.fl')]
        .filter((el) => el.offsetParent) // 모바일에서 숨긴 사본 제외
        .map((el) => {
          const z = Math.random();
          const f: Fl = {
            el, li: items.get(el.dataset.i)!, g: Number(el.dataset.g), w: el.offsetWidth, h: el.offsetHeight,
            x: rnd(-40, BW), y: rnd(-20, BH), z, th: rnd(0, Math.PI * 2),
            o1: rnd(0.04, 0.12), p1: rnd(0, 6.3), o2: rnd(0.1, 0.25), p2: rnd(0, 6.3),
            r: 0, s: 0.5 + 0.45 * z, op: 0.1 + 0.18 * z, // 먼 것 0.1, 가까운 것 0.28(0.35는 문단 뒤 로고 칸 색이 읽기를 방해했다)
          };
          el.style.zIndex = String(Math.round(z * 100));
          el.style.opacity = String(f.op);
          el.style.transform = floatTransform(f);
          return f;
        });
    };
    let bt = 0; // 배지 시간(스킬 화면이 열린 동안은 멈춤)
    const moveBadges = (dt: number) => {
      bt += dt;
      const BW = layer.clientWidth, BH = layer.clientHeight;
      for (const f of fls) {
        const th = f.th + 0.7 * Math.sin(f.o1 * bt + f.p1);
        const v = 6 + 20 * f.z; // px/s: 먼 것은 느리게
        f.x += Math.cos(th) * v * dt;
        f.y += Math.sin(th) * v * dt;
        f.r = 6 * Math.sin(f.o2 * bt + f.p2);
        // 화면 밖으로 완전히 나가면 반대편 밖에서 다시 들어온다(감기는 순간이 안 보이게 배지 크기만큼 여유)
        const mx = f.w, my = f.h;
        if (f.x > BW + mx) f.x = -2 * mx;
        else if (f.x < -2 * mx) f.x = BW + mx;
        if (f.y > BH + my) f.y = -2 * my;
        else if (f.y < -2 * my) f.y = BH + my;
        f.el.style.transform = floatTransform(f);
      }
    };

    // --- 루프: S6가 화면에 있을 때만 ---
    let state: 'closed' | 'opening' | 'open' | 'closing' = 'closed';
    let visible = false, raf = 0, last = 0;
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      t += dt;
      // 워프 구간에 별이 빨라졌다가(줄무늬), 끝나면 천천히 원래 속도로
      const tau = warp ? now - warp.t0 : -1;
      const hot = !!warp && (warp.dir > 0 ? tau > WARP_SHAKE - 50 && tau < WARP_SHAKE + WARP_FLY : tau < WARP_FLY + 50);
      boost += ((hot ? 18 : 1) - boost) * (1 - Math.exp(-dt * (hot ? 8 : 3)));
      drawStars(dt);
      drawWarp(now);
      if (state === 'closed') moveBadges(dt);
    };
    const run = () => {
      if (reduce || raf || !(visible || warp)) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const halt = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) run();
      else if (!warp) halt();
    }, { rootMargin: '-2px 0px' }).observe(sec);
    const setup = () => {
      sizeStars();
      drawStars(0);
      if (!reduce && state === 'closed') initBadges();
    };
    setup();
    let rt = 0;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(setup, 150);
    });

    // --- 스크롤 잠금 ---
    let savedY = 0;
    const guard = (e: Event) => {
      if (state !== 'closed' && !(e.target instanceof Node && panel.contains(e.target))) e.preventDefault();
    };
    addEventListener('wheel', guard, { passive: false });
    addEventListener('touchmove', guard, { passive: false });
    const lock = () => {
      const top = sec.getBoundingClientRect().top + scrollY;
      if (scrollY < top) scrollTo({ top, behavior: 'instant' }); // S6가 화면을 다 덮은 상태에서 연다
      savedY = scrollY;
      root.classList.add('skills-lock');
      if (nav) nav.inert = true;
    };
    const unlock = () => {
      root.classList.remove('skills-lock');
      scrollTo({ top: savedY, behavior: 'instant' });
      if (nav) nav.inert = false;
    };

    // --- 열기 / 닫기 ---
    const timers: number[] = [];
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const delay = (f: Fl) => f.g * STAGGER;
    // 소개 글을 점 입자로 바꿔 워프를 시작한다. 실패하면(샘플링 오류, 글 픽셀 없음) false → 기존 블록 페이드 경로
    const startWarp = (dir: 1 | -1) => {
      let w: ReturnType<typeof sampleText> = null;
      try {
        w = sampleText();
      } catch {
        w = null;
      }
      sec.dataset.warp = String(w ? w.n : 0);
      if (!w) return false;
      warp = { ...w, t0: performance.now(), dir };
      run();
      return true;
    };
    const WARP_LAG = 550; // 워프 후반부터 배지가 앞으로 나와 정렬된다
    const open = () => {
      if (state !== 'closed') return;
      state = 'opening';
      lock();
      openBtn.setAttribute('aria-expanded', 'true');
      const warped = !reduce && startWarp(1);
      if (warped) sec.classList.add('is-warp'); // DOM 글은 즉시 투명(제자리), 같은 자리에서 입자가 시작한다
      sec.classList.add('is-open');
      story.inert = true;
      story.setAttribute('aria-hidden', 'true');
      closeBtn.focus({ preventScroll: true });
      if (reduce) {
        sec.classList.add('is-landed');
        state = 'open';
        return;
      }
      const lag = warped ? WARP_LAG : 0;
      later(() => {
        const base = layer.getBoundingClientRect();
        for (const f of fls) {
          const b = (f.li.firstElementChild as HTMLElement).getBoundingClientRect();
          f.el.style.transition = `transform ${MOVE}ms cubic-bezier(0.65, 0, 0.25, 1) ${delay(f)}ms, opacity ${MOVE}ms ease ${delay(f)}ms`;
          f.el.style.transform = `translate3d(${b.left - base.left}px, ${b.top - base.top}px, 0)`;
          f.el.style.opacity = '1';
        }
      }, lag);
      later(() => {
        sec.classList.add('is-landed'); // li 보이기, 사본은 사라진다
        for (const f of fls) {
          f.el.style.transition = `opacity ${FADE}ms ease`;
          f.el.style.opacity = '0';
        }
        state = 'open';
      }, lag + MOVE + 3 * STAGGER);
    };
    const close = () => {
      if (state !== 'open') return;
      state = 'closing';
      openBtn.setAttribute('aria-expanded', 'false');
      const done = () => {
        sec.classList.remove('is-closing', 'is-warp', 'is-warp-out');
        warp = null;
        unlock();
        story.inert = false;
        story.removeAttribute('aria-hidden');
        state = 'closed';
        openBtn.focus({ preventScroll: true });
      };
      if (reduce) {
        sec.classList.remove('is-open', 'is-landed');
        done();
        return;
      }
      // 오버레이 안에서 스크롤했다면 li 자리가 바뀌었으니 사본을 지금 자리로 옮겨 둔 뒤 보인다
      const base = layer.getBoundingClientRect();
      for (const f of fls) {
        const b = (f.li.firstElementChild as HTMLElement).getBoundingClientRect();
        f.el.style.transition = 'none';
        f.el.style.transform = `translate3d(${b.left - base.left}px, ${b.top - base.top}px, 0)`;
      }
      void layer.offsetWidth;
      sec.classList.remove('is-landed');
      for (const f of fls) {
        f.el.style.transition = `opacity ${FADE}ms ease`;
        f.el.style.opacity = '1';
      }
      later(() => {
        sec.classList.remove('is-open');
        for (const f of fls) {
          f.el.style.transition = `transform ${MOVE}ms cubic-bezier(0.65, 0, 0.25, 1) ${(3 - f.g) * STAGGER}ms, opacity ${MOVE}ms ease ${(3 - f.g) * STAGGER}ms`;
          f.el.style.transform = floatTransform(f); // 열기 직전의 부유 상태(배지 시간은 멈춰 있었다)
          f.el.style.opacity = String(f.op);
        }
        later(() => {
          for (const f of fls) f.el.style.transition = '';
        }, MOVE + 3 * STAGGER);
        const block = () => {
          sec.classList.remove('is-warp');
          sec.classList.add('is-closing'); // 소개 글이 제자리로 돌아온다(역시차)
          later(done, MOVE + 3 * STAGGER + 400); // 소개 글 복귀(최대 지연 550ms + 0.8s)까지 기다린다
        };
        if (!sec.classList.contains('is-warp')) return block();
        // 워프 역방향: 배지가 돌아가는 동안 입자가 바깥에서 글 자리로 모이고, 끝나면 DOM 글과 교차 페이드
        later(() => {
          if (!startWarp(-1)) return block();
          later(() => sec.classList.replace('is-warp', 'is-warp-out'), WARP_FLY + WARP_SHAKE);
          later(done, WARP_FLY + WARP_SHAKE + WARP_FADE + 30);
        }, 200);
      }, FADE);
    };
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && state === 'open') close();
    });
  }
</script>
