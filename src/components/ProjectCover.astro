---
// 상세 페이지 표지. 홈 폴더와 같은 2D 합성 그림(src/stage/coverArt.ts drawCover, three 없음, 1024×1536 틀 가운데에 폴더 1 × 1.3)을 한 번 그린다.
// 위아래는 투명 여백이라, 그린 뒤 detail.css의 색 블록 배경과 상자 그림자를 인라인으로 끈다(그림자는 그림 안에 있다).
// JS가 꺼져 있으면 hue 색 블록만 보인다. view-transition-name(book-cover)은 홈 전환 오버레이와 같다(detail.css).
interface Props { slug: string; title: string; hue: number; order: number }
const { slug, title, hue, order } = Astro.props;
---
<canvas class="project-cover" width="1024" height="1536" aria-hidden="true" data-slug={slug} data-title={title} data-hue={hue} data-order={order} style={`--hue: ${hue}`}></canvas>

<script>
  import { drawCover } from '../stage/coverArt';
  const el = document.querySelector<HTMLCanvasElement>('.project-cover');
  const x = el?.getContext('2d');
  if (el && x) {
    const d = el.dataset;
    const book = { slug: d.slug ?? '', title: d.title ?? '', summary: '', hue: Number(d.hue), order: Number(d.order), href: '' };
    try {
      const t0 = performance.now();
      x.drawImage(drawCover(book), 0, 0);
      el.dataset.drawMs = String(Math.round(performance.now() - t0)); // 확인용(그리기 시간)
      Object.assign(el.style, { background: 'transparent', boxShadow: 'none' });
    } catch {
      // 그리기에 실패하면 색 블록 그대로
    }
  }
</script>
