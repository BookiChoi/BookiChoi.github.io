---
// 히어로 잉크 캔버스(#s0 전체, stage.css .hero-ink). WebGL2로 배경 + 잉크 리빌 + 이름 글자(잉크 안은 흰색)를 그린다.
// 준비되면 html.ink-on이 붙고 DOM h1은 투명 글자가 된다. JS 꺼짐, reduced-motion, WebGL2 없음이면 DOM 검정 이름 그대로.
---
<canvas class="hero-ink" aria-hidden="true"></canvas>

<script>
  import { initInk } from '../stage/ink';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-ink');
  if (canvas) initInk(canvas);
</script>
