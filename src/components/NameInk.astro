---
// 히어로 잉크 캔버스. #s0 안에 두면 섹션 전체를 덮는다(stage.css .hero-ink). 배경 위·이름(h1) 아래 레이어에 붓 획을 그린다.
// 글자는 건드리지 않는다. JS가 꺼져 있거나 reduced-motion이면 빈 투명 캔버스로 남는다.
---
<canvas class="hero-ink" aria-hidden="true"></canvas>

<script>
  import { initInk } from '../stage/ink';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-ink');
  if (canvas) initInk(canvas);
</script>
